#!/bin/bash
# mghelper postinst (v0.2.0)
#  1) 给二进制加 setuid 位（owner root），让 mobile 身份跑它时自动提权
#     —— iOS 上各 App 容器属于独立本地用户，mobile 读不了别人沙盒，必须 root
#  2) 启动桥接守护进程：roothide 下 LaunchDaemon **不会自动加载**，必须在这里 load
#  3) 立刻跑一次单次桥接，装完尽快让小组件拿到数据
#
# 兼容三种安装位置：roothide 随机 .jbroot-XXXX / rootless 的 /var/jb / rootful 真实根。
# 找不到就直接退出（不阻断安装），用户可以手动排障。
log() { echo "MGHelper: $*"; }

# ---- 定位 jbroot ----
JB=""
for d in /var/containers/Bundle/Application/.jbroot* ; do
    [ -d "$d" ] && JB="$d" && break
done
if [ -z "$JB" ] && [ -d /var/jb ]; then JB="/var/jb"; fi
log "jbroot=${JB:-<rootful>}"

# ---- 在候选前缀里找文件：$JB / /var/jb / 真实根 ----
lookup() {
    for p in "$JB" /var/jb "" ; do
        if [ -n "$p" ]; then f="$p/$1"; else f="/$1"; fi
        if [ -f "$f" ]; then echo "$f"; return 0; fi
    done
    return 1
}

# ---- 1) setuid ----
BIN="$(lookup usr/bin/mghelper 2>/dev/null)"
if [ -n "$BIN" ]; then
    chown root:wheel "$BIN" 2>/dev/null
    chmod 6755 "$BIN" 2>/dev/null
    log "setuid set: $BIN -> $(ls -l "$BIN" 2>/dev/null | awk '{print $1, $3, $4}')"
else
    log "!! mghelper 二进制未找到"
fi

# ---- 2) 守护进程 ----
LC="$(command -v launchctl 2>/dev/null)"
if [ -z "$LC" ]; then
    for p in "$JB/basebin/launchctl" "$JB/bin/launchctl" /var/jb/bin/launchctl \
             /bin/launchctl /usr/bin/launchctl ; do
        [ -x "$p" ] && LC="$p" && break
    done
fi
[ -z "$LC" ] && LC="launchctl"

PLIST="$(lookup Library/LaunchDaemons/com.banliren.mghelper.bridge.plist 2>/dev/null)"
if [ -n "$PLIST" ]; then
    chown root:wheel "$PLIST" 2>/dev/null
    chmod 0644 "$PLIST" 2>/dev/null
    "$LC" unload "$PLIST" 2>/dev/null
    if   "$LC" load -w "$PLIST" 2>/dev/null; then log "daemon loaded(-w): $PLIST"
    elif "$LC" bootstrap system "$PLIST" 2>/dev/null; then log "daemon bootstrapped: $PLIST"
    elif "$LC" load "$PLIST" 2>/dev/null; then log "daemon loaded: $PLIST"
    else log "!! daemon load 失败 (launchctl=$LC plist=$PLIST)"; fi
    log "launchctl list | grep mghelper: $("$LC" list 2>/dev/null | grep -i mghelper)"
else
    log "!! daemon plist 未找到"
fi

# ---- 3) 预建日志目录 + 立刻同步一次 ----
mkdir -p "$JB/var/mobile/Library/MG7Widget" 2>/dev/null
mkdir -p /var/mobile/Library/MG7Widget 2>/dev/null
if [ -n "$BIN" ]; then
    "$BIN" bridge-once 2>&1 | while read -r l; do log "$l"; done
fi

exit 0
